{
    "name": "midnight-indigo",
    "displayName": "Midnight Indigo",
    "description": "An ultra-dark theme in eight colors — indigo, purple, pink, red, orange, green, cyan and blue — that draws the whole of VS Code, from the editor to the terminal, Git and chat, with each palette designed for its own hue, semantic highlighting checked against real code, and a 305-icon file set built on the languages' own logos.",
    "version": "10.0.0",
    "publisher": "diguu-rl",
    "license": "MIT",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark theme",
        "icon theme",
        "file icons",
        "folder icons",
        "semantic highlighting",
        "accessibility",
        "indigo",
        "purple",
        "pink",
        "red",
        "orange",
        "green",
        "cyan",
        "blue"
    ],
    "galleryBanner": {
        "color": "#020108",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/DigUu-RL/midnight-indigo.git"
    },
    "bugs": {
        "url": "https://github.com/DigUu-RL/midnight-indigo/issues"
    },
    "homepage": "https://github.com/DigUu-RL/midnight-indigo#readme",
    "scripts": {
        "typecheck": "tsc",
        "measure:glyphs": "node tools/icons/measure.ts",
        "audit:icons": "node tools/icons/audit-icons.ts",
        "audit:coverage": "node tools/icons/audit-coverage.ts",
        "audit:accessibility": "node tools/theme/check-accessibility.ts",
        "import:marks": "node tools/icons/import-marks.ts",
        "import:pictograms": "node tools/icons/import-pictograms.ts",
        "build:icons": "node tools/icons/build-icons.ts",
        "build:themes": "node tools/theme/build-color-themes.ts",
        "build": "npm run build:themes && npm run build:icons",
        "package": "vsce package",
        "check:package": "node tools/release/check-package.ts",
        "preview:icons": "node tools/icons/build-icons.ts && node tools/preview/preview.ts",
        "preview:gallery": "node tools/preview/build-icon-preview.ts",
        "preview:theme": "node tools/preview/build-theme-preview.ts",
        "preview:workbench": "node tools/preview/build-workbench-preview.ts",
        "check:images": "node tools/docs/check-images.ts",
        "check": "node tools/check.ts",
        "snapshot": "node tools/regression/snapshot.ts",
        "regression": "node tools/regression/regression.ts",
        "inventory": "node tools/docs/inventory.ts",
        "import:vscode-colors": "node tools/theme/import-vscode-colors.ts"
    },
    "contributes": {
        "themes": [
            {
                "label": "Midnight Indigo",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-indigo-color-theme.json"
            },
            {
                "label": "Midnight Purple",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-purple-color-theme.json"
            },
            {
                "label": "Midnight Pink",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-pink-color-theme.json"
            },
            {
                "label": "Midnight Red",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-red-color-theme.json"
            },
            {
                "label": "Midnight Orange",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-orange-color-theme.json"
            },
            {
                "label": "Midnight Green",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-green-color-theme.json"
            },
            {
                "label": "Midnight Cyan",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-cyan-color-theme.json"
            },
            {
                "label": "Midnight Blue",
                "uiTheme": "vs-dark",
                "path": "./themes/midnight-blue-color-theme.json"
            }
        ],
        "iconThemes": [
            {
                "id": "midnight-indigo-icons",
                "label": "Midnight Icons",
                "path": "./icons/theme/midnight-indigo-icon-theme.json"
            }
        ],
        "grammars": [
            {
                "scopeName": "midnight-indigo.csharp-delegates.injection",
                "path": "./injections/csharp-delegates.tmLanguage.json",
                "injectTo": [
                    "source.cs"
                ]
            }
        ]
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@vscode/vsce": "^3.9.2",
        "playwright-core": "^1.63.0",
        "shiki": "^4.4.3",
        "typescript": "^5.7.2"
    }
}
