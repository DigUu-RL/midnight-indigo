    "sideBar.border": "#001B07",
    "sideBarTitle.foreground": "#86AB90",
    "sideBarSectionHeader.background": "#000E04",
    "sideBarSectionHeader.border": "#001B07",
    "statusBar.background": "#000E04",
    "statusBar.foreground": "#799C82",
    "statusBar.border": "#001B07",
    "statusBar.debuggingBackground": "#7142E2",
    "statusBar.noFolderBackground": "#000E04",
    "statusBarItem.hoverBackground": "#002507",
    "statusBarItem.remoteBackground": "#005D38",
    "tab.activeBackground": "#000E04",
    "tab.activeForeground": "#9CBEA5",
    "tab.inactiveBackground": "#000300",
    "tab.inactiveForeground": "#4E7B59",
    "tab.border": "#001B07",
    "tab.activeBorderTop": "#008D50",
    "tab.unfocusedActiveBorderTop": "#005D38",
    "editorGroupHeader.tabsBackground": "#000502",
    "editorGroupHeader.border": "#001B07",
    "editorGroup.border": "#001B07",
    "panel.background": "#000502",
    "panel.border": "#001B07",
    "panelTitle.activeBorder": "#008D50",
    "panelTitle.activeForeground": "#86AB90",
    "panelTitle.inactiveForeground": "#4E7B59",
    "input.background": "#000E04",
    "input.border": "#00401A",
    "input.foreground": "#86AB90",
    "input.placeholderForeground": "#4E7B59",
    "dropdown.background": "#000E04",
    "dropdown.border": "#00401A",
    "dropdown.foreground": "#86AB90",
    "list.activeSelectionBackground": "#001B07",
    "list.activeSelectionForeground": "#9CBEA5",
    "list.inactiveSelectionBackground": "#000E04",
    "list.hoverBackground": "#000E04",
    "list.focusBackground": "#002507",
    "list.highlightForeground": "#EE6AF3",
    "scrollbar.shadow": "#000401",
    "scrollbarSlider.background": "#005D3855",
    "scrollbarSlider.hoverBackground": "#005D3888",
    "scrollbarSlider.activeBackground": "#008D50AA",
    "button.background": "#008D50",
    "button.foreground": "#FFFFFF",
    "badge.background": "#005D38",
    "badge.foreground": "#FFFFFF",
    "terminal.background": "#000300",
    "terminal.foreground": "#86AB90",
    "terminal.ansiBlack": "#000701",
    "terminal.ansiRed": "#EE6AF3",
    "terminal.ansiGreen": "#BBD887",
    "terminal.ansiYellow": "#FFCA96",
    "terminal.ansiBlue": "#55B4FF",
    "terminal.ansiMagenta": "#7142E2",
    "terminal.ansiCyan": "#4AD9D9",
    "terminal.ansiWhite": "#86AB90",
    "terminal.ansiBrightBlack": "#275734",
    "terminal.ansiBrightRed": "#EF90F9",
    "terminal.ansiBrightGreen": "#D0EE9F",
    "terminal.ansiBrightYellow": "#FFD8B7",
    "terminal.ansiBrightBlue": "#8BCCFF",
    "terminal.ansiBrightMagenta": "#7C77FF",
    "terminal.ansiBrightCyan": "#7FEEED",
    "terminal.ansiBrightWhite": "#E9F7EE",
    "diffEditor.insertedTextBackground": "#BBD88722",
    "diffEditor.removedTextBackground": "#EE6AF322",
    "gitDecoration.modifiedResourceForeground": "#55B4FF",
    "gitDecoration.addedResourceForeground": "#BBD887",
    "gitDecoration.deletedResourceForeground": "#EE6AF3",
    "gitDecoration.untrackedResourceForeground": "#FFCA96",
    "peekViewEditor.background": "#000300",
    "peekViewResult.background": "#000502",
    "peekView.border": "#005D38"
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4E7B59",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.important",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#EE6AF3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Nomes reservados de declaração de tipo NÃO herdam a cor do nome do tipo (fix defensivo interface/enum/struct/record/class)",
      "scope": [
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.type.record",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#EE6AF3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Constantes de linguagem (true/false/null/undefined/this/self)",
      "scope": [
        "constant.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#EE6AF3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#BBD887"
      }
    },
    {
      "name": "Sequências de escape dentro de strings",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash"
      ],
      "settings": {
        "foreground": "#EE6AF3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Interpolação de strings (marcadores ${} #{} $())",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#EE6AF3"
      }
    },
    {
      "name": "Pontuação e chaves/colchetes/vírgulas",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.terminator.statement",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.accessor",
        "punctuation.definition.typeparameters",
        "punctuation.definition.generic",
        "meta.generic.punctuation",
        "punctuation.brace.angle"
      ],
      "settings": {
        "foreground": "#EE6AF3",
        "fontStyle": ""
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FC9888"
      }
    },
    {
      "name": "Operadores (somente cor, nunca negrito/itálico)",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.new",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.other",
        "punctuation.definition.arrow",
        "punctuation.operator",
        "storage.type.function.arrow",
        "keyword.operator.assignment.compound"
      ],
      "settings": {
        "foreground": "#4CC768",
        "fontStyle": ""
      }
    },
    {
      "name": "Métodos e funções - declaração",
      "scope": [
        "entity.name.function",
        "meta.function.declaration entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#55B4FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Métodos e funções - chamada",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.call",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#55B4FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Membros estáticos (métodos, campos e propriedades static) - sempre itálico",
      "scope": [
        "entity.name.function.static",
        "variable.other.property.static",
        "variable.other.object.property.static",
        "meta.definition.variable.static",
        "storage.modifier.static ~ entity.name.function",
        "meta.definition.property.static"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes (inclui sealed - mesmo padrão de classes comuns)",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4AD9D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Delegates C# (Action / Func / Predicate) - mesma cor de métodos, em negrito",
      "scope": [
        "support.type.delegate.cs",
        "support.class.action",
        "support.class.func",
        "support.class.action.cs",
        "support.class.func.cs"
      ],
      "settings": {
        "foreground": "#55B4FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Components (JSX/TSX) - mesmo tratamento visual de classes",
      "scope": [
        "support.class.component",
        "entity.name.function.component"
      ],
      "settings": {
        "foreground": "#4AD9D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Records e Structs (mesma regra de classes, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.record",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#4AD9D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes/records/structs estáticos - apenas itálico, sem negrito (fallback léxico; ver semanticTokenColors para cobertura em qualquer ponto de uso)",
      "scope": [
        "entity.name.class.static",
        "meta.class.static entity.name.class"
      ],
      "settings": {
        "foreground": "#4AD9D9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interfaces e Enums (mesma cor, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.other.inherited-class.interface",
        "meta.interface"
      ],
      "settings": {
        "foreground": "#FFCA96",
        "fontStyle": ""
      }
    },
    {
      "name": "Valores de enum (cor diferenciada)",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#F489B5"
      }
    },
    {
      "name": "Variáveis locais",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.local",
        "meta.definition.variable variable.other"
      ],
      "settings": {
        "foreground": "#A5CBAE",
        "fontStyle": ""
      }
    },
    {
      "name": "Parâmetros de métodos - sempre itálico",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#A5CBAE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades e campos de classes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.field.declaration",
        "variable.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#52CF93",
        "fontStyle": ""
      }
    },
    {
      "name": "Generics (apenas o nome do tipo, os símbolos < > seguem a cor de pontuação)",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "meta.type.arguments entity.name.type",
        "meta.type.parameters storage.type",
        "meta.type.arguments storage.type"
      ],
      "settings": {
        "foreground": "#7142E2",
        "fontStyle": ""
      }
    },
    {
      "name": "Decoradores / Atributos (JS, TS, Python, C#)",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#FC9888",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tipos primitivos",
      "scope": [
        "support.type",
        "storage.type.primitive",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#4AD9D9",
        "fontStyle": ""
      }
    },
    {
      "name": "PowerShell - Variáveis ($var)",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell"
      ],
      "settings": {
        "foreground": "#A5CBAE"
      }
    },
    {
      "name": "PowerShell - Cmdlets",
      "scope": [
        "support.function.powershell",
        "entity.name.function.powershell"
      ],
      "settings": {
        "foreground": "#55B4FF"
      }
    },
    {
      "name": "PowerShell - Parâmetros (-Param)",
      "scope": [
        "variable.parameter.powershell"
      ],
      "settings": {
        "foreground": "#A5CBAE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Cabeçalhos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#4AD9D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#86AB90",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#86AB90",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Links",
      "scope": [
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#55B4FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown - Código inline/bloco",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#F489B5"
      }
    },
    {
      "name": "Markdown - Citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#4E7B59",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON - Chaves (keys)",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#52CF93"
      }
    },
    {
      "name": "JSON - Valores string",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#BBD887"
      }
    },
    {
      "name": "JSON - Constantes (true/false/null)",
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#EE6AF3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Tags/atributos genéricos de markup",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#52CF93",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#4AD9D9",
      "fontStyle": "bold"
    },
    "class.static": {
      "foreground": "#4AD9D9",
      "fontStyle": "italic"
    },
    "class.sealed": {
      "foreground": "#4AD9D9",
      "fontStyle": "bold"
    },
    "delegate": {
      "foreground": "#55B4FF",
      "fontStyle": "bold"
    },
    "struct": {
      "foreground": "#4AD9D9",
      "fontStyle": "bold"
    },
    "struct.static": {
      "foreground": "#4AD9D9",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#FFCA96",
      "fontStyle": ""
    },
    "enum": {
      "foreground": "#FFCA96",
      "fontStyle": ""
    },
    "enumMember": {
      "foreground": "#F489B5",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#7142E2",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#4AD9D9",
      "fontStyle": ""
    },
    "method": {
      "foreground": "#55B4FF",
      "fontStyle": ""
    },
    "method.declaration": {
      "foreground": "#55B4FF",
      "fontStyle": "bold"
    },
    "method.definition": {
      "foreground": "#55B4FF",
      "fontStyle": "bold"
    },
    "method.static": {
      "foreground": "#55B4FF",
      "fontStyle": "italic"
    },
    "method.declaration.static": {
      "foreground": "#55B4FF",
      "fontStyle": "bold italic"
    },
    "method.static.declaration": {
      "foreground": "#55B4FF",
      "fontStyle": "bold italic"
    },
    "function": {
      "foreground": "#55B4FF",
      "fontStyle": ""
    },
    "function.declaration": {
      "foreground": "#55B4FF",
      "fontStyle": "bold"
    },
    "function.definition": {
      "foreground": "#55B4FF",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#A5CBAE",
      "fontStyle": "italic"
    },
    "variable:typescript": {
      "foreground": "#A5CBAE",
      "fontStyle": ""
    },
    "variable:typescriptreact": {
      "foreground": "#A5CBAE",
      "fontStyle": ""
    },
    "variable:javascript": {
      "foreground": "#A5CBAE",
      "fontStyle": ""
    },
    "variable:javascriptreact": {
      "foreground": "#A5CBAE",
      "fontStyle": ""
    },
    "variable.static": {
      "foreground": "#52CF93",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#52CF93",
      "fontStyle": ""
    },
    "property.static": {
      "foreground": "#52CF93",
      "fontStyle": "italic"
    },
    "property.readonly": {
      "foreground": "#52CF93",
      "fontStyle": ""
    },
    "property.readonly.static": {
      "foreground": "#52CF93",
      "fontStyle": "italic"
    },
    "*.readonly:csharp": {
      "foreground": "#52CF93"
    },
    "namespace": {
      "foreground": "#86AB90",
      "fontStyle": ""
    },
    "operator": {
      "foreground": "#4CC768",
      "fontStyle": ""
    },
    "keyword": {
