    "tab.unfocusedActiveBorderTop": "#005F1D",
    "editorGroupHeader.tabsBackground": "#000502",
    "editorGroupHeader.border": "#001B07",
    "editorGroup.border": "#001B07",
    "panel.background": "#000502",
    "panel.border": "#001B07",
    "panelTitle.activeBorder": "#009D11",
    "panelTitle.activeForeground": "#88AB90",
    "panelTitle.inactiveForeground": "#507B5A",
    "input.background": "#010D04",
    "input.border": "#00401A",
