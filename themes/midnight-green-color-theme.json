    "statusBar.background": "#010D04",
    "statusBar.foreground": "#7A9C83",
    "statusBar.border": "#001B07",
    "statusBar.debuggingBackground": "#007798",
    "statusBar.noFolderBackground": "#010D04",
    "statusBarItem.hoverBackground": "#002507",
    "statusBarItem.remoteBackground": "#005F1D",
