    "tab.border": "#290807",
    "tab.activeBorderTop": "#D52D43",
    "tab.unfocusedActiveBorderTop": "#872629",
    "editorGroupHeader.tabsBackground": "#080201",
    "editorGroupHeader.border": "#290807",
    "editorGroup.border": "#290807",
    "panel.background": "#080201",
    "panel.border": "#290807",
    "panelTitle.activeBorder": "#D52D43",
    "panelTitle.activeForeground": "#BD918A",
    "panelTitle.inactiveForeground": "#915C56",
    "input.background": "#150503",
    "input.border": "#5A1E19",
    "input.foreground": "#BD918A",
    "input.placeholderForeground": "#915C56",
    "dropdown.background": "#150503",
    "dropdown.border": "#5A1E19",
    "dropdown.foreground": "#BD918A",
    "list.activeSelectionBackground": "#290807",
    "list.activeSelectionForeground": "#CFA79F",
    "list.inactiveSelectionBackground": "#150503",
    "list.hoverBackground": "#150503",
    "list.focusBackground": "#3B0709",
    "list.highlightForeground": "#EC72E5",
    "scrollbar.shadow": "#080101",
    "scrollbarSlider.background": "#87262955",
    "scrollbarSlider.hoverBackground": "#87262988",
    "scrollbarSlider.activeBackground": "#D52D43AA",
    "button.background": "#D52D43",
    "button.foreground": "#FFFFFF",
    "badge.background": "#872629",
    "badge.foreground": "#FFFFFF",
    "terminal.background": "#070000",
    "terminal.foreground": "#BD918A",
    "terminal.ansiBlack": "#0F0101",
    "terminal.ansiRed": "#EC72E5",
    "terminal.ansiGreen": "#72CCAE",
    "terminal.ansiYellow": "#80E97E",
    "terminal.ansiBlue": "#87A9FF",
    "terminal.ansiMagenta": "#913BBF",
    "terminal.ansiCyan": "#64D3EC",
    "terminal.ansiWhite": "#BD918A",
    "terminal.ansiBrightBlack": "#6E3A34",
    "terminal.ansiBrightRed": "#F393E6",
    "terminal.ansiBrightGreen": "#8BE1C3",
    "terminal.ansiBrightYellow": "#A7F19A",
    "terminal.ansiBrightBlue": "#A8C4FF",
    "terminal.ansiBrightMagenta": "#BD5FD2",
    "terminal.ansiBrightCyan": "#8EE9FE",
    "terminal.ansiBrightWhite": "#FFEFEB",
    "diffEditor.insertedTextBackground": "#72CCAE22",
    "diffEditor.removedTextBackground": "#EC72E522",
    "gitDecoration.modifiedResourceForeground": "#87A9FF",
    "gitDecoration.addedResourceForeground": "#72CCAE",
    "gitDecoration.deletedResourceForeground": "#EC72E5",
    "gitDecoration.untrackedResourceForeground": "#80E97E",
    "peekViewEditor.background": "#070000",
    "peekViewResult.background": "#080201",
    "peekView.border": "#872629"
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#915C56",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.important",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#EC72E5",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Nomes reservados de declaração de tipo NÃO herdam a cor do nome do tipo (fix defensivo interface/enum/struct/record/class)",
      "scope": [
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.type.record",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#EC72E5",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Constantes de linguagem (true/false/null/undefined/this/self)",
      "scope": [
        "constant.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#EC72E5",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#72CCAE"
      }
    },
    {
      "name": "Sequências de escape dentro de strings",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash"
      ],
      "settings": {
        "foreground": "#EC72E5",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Interpolação de strings (marcadores ${} #{} $())",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#EC72E5"
      }
    },
    {
      "name": "Pontuação e chaves/colchetes/vírgulas",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.terminator.statement",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.accessor",
        "punctuation.definition.typeparameters",
        "punctuation.definition.generic",
        "meta.generic.punctuation",
        "punctuation.brace.angle"
      ],
      "settings": {
        "foreground": "#EC72E5",
        "fontStyle": ""
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#DCD27A"
      }
    },
    {
      "name": "Operadores (somente cor, nunca negrito/itálico)",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.new",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.other",
        "punctuation.definition.arrow",
        "punctuation.operator",
        "storage.type.function.arrow",
        "keyword.operator.assignment.compound"
      ],
      "settings": {
        "foreground": "#F9746D",
        "fontStyle": ""
      }
    },
    {
      "name": "Métodos e funções - declaração",
      "scope": [
        "entity.name.function",
        "meta.function.declaration entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#87A9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Métodos e funções - chamada",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.call",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#87A9FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Membros estáticos (métodos, campos e propriedades static) - sempre itálico",
      "scope": [
        "entity.name.function.static",
        "variable.other.property.static",
        "variable.other.object.property.static",
        "meta.definition.variable.static",
        "storage.modifier.static ~ entity.name.function",
        "meta.definition.property.static"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes (inclui sealed - mesmo padrão de classes comuns)",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#64D3EC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Delegates C# (Action / Func / Predicate) - mesma cor de métodos, em negrito",
      "scope": [
        "support.type.delegate.cs",
        "support.class.action",
        "support.class.func",
        "support.class.action.cs",
        "support.class.func.cs"
      ],
      "settings": {
        "foreground": "#87A9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Components (JSX/TSX) - mesmo tratamento visual de classes",
      "scope": [
        "support.class.component",
        "entity.name.function.component"
      ],
      "settings": {
        "foreground": "#64D3EC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Records e Structs (mesma regra de classes, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.record",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#64D3EC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes/records/structs estáticos - apenas itálico, sem negrito (fallback léxico; ver semanticTokenColors para cobertura em qualquer ponto de uso)",
      "scope": [
        "entity.name.class.static",
        "meta.class.static entity.name.class"
      ],
      "settings": {
        "foreground": "#64D3EC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interfaces e Enums (mesma cor, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.other.inherited-class.interface",
        "meta.interface"
      ],
      "settings": {
        "foreground": "#80E97E",
        "fontStyle": ""
      }
    },
    {
      "name": "Valores de enum (cor diferenciada)",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#F3C466"
      }
    },
    {
      "name": "Variáveis locais",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.local",
        "meta.definition.variable variable.other"
      ],
      "settings": {
        "foreground": "#DEB0A8",
        "fontStyle": ""
      }
    },
    {
      "name": "Parâmetros de métodos - sempre itálico",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#DEB0A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades e campos de classes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.field.declaration",
        "variable.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#FF9578",
        "fontStyle": ""
      }
    },
    {
      "name": "Generics (apenas o nome do tipo, os símbolos < > seguem a cor de pontuação)",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "meta.type.arguments entity.name.type",
        "meta.type.parameters storage.type",
        "meta.type.arguments storage.type"
      ],
      "settings": {
        "foreground": "#913BBF",
        "fontStyle": ""
      }
    },
    {
      "name": "Decoradores / Atributos (JS, TS, Python, C#)",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#DCD27A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tipos primitivos",
      "scope": [
        "support.type",
        "storage.type.primitive",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#64D3EC",
        "fontStyle": ""
      }
    },
    {
      "name": "PowerShell - Variáveis ($var)",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell"
      ],
      "settings": {
        "foreground": "#DEB0A8"
      }
    },
    {
      "name": "PowerShell - Cmdlets",
      "scope": [
        "support.function.powershell",
        "entity.name.function.powershell"
      ],
      "settings": {
        "foreground": "#87A9FF"
      }
    },
    {
      "name": "PowerShell - Parâmetros (-Param)",
      "scope": [
        "variable.parameter.powershell"
      ],
      "settings": {
        "foreground": "#DEB0A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Cabeçalhos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#64D3EC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#BD918A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#BD918A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Links",
      "scope": [
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#87A9FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown - Código inline/bloco",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#F3C466"
      }
    },
    {
      "name": "Markdown - Citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#915C56",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON - Chaves (keys)",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#FF9578"
      }
    },
    {
      "name": "JSON - Valores string",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#72CCAE"
      }
    },
    {
      "name": "JSON - Constantes (true/false/null)",
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#EC72E5",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Tags/atributos genéricos de markup",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FF9578",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#64D3EC",
      "fontStyle": "bold"
    },
    "class.static": {
      "foreground": "#64D3EC",
      "fontStyle": "italic"
    },
    "class.sealed": {
      "foreground": "#64D3EC",
      "fontStyle": "bold"
    },
    "delegate": {
      "foreground": "#87A9FF",
      "fontStyle": "bold"
    },
    "struct": {
      "foreground": "#64D3EC",
      "fontStyle": "bold"
    },
    "struct.static": {
      "foreground": "#64D3EC",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#80E97E",
      "fontStyle": ""
    },
    "enum": {
      "foreground": "#80E97E",
      "fontStyle": ""
    },
    "enumMember": {
      "foreground": "#F3C466",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#913BBF",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#64D3EC",
      "fontStyle": ""
    },
    "method": {
      "foreground": "#87A9FF",
      "fontStyle": ""
    },
    "method.declaration": {
      "foreground": "#87A9FF",
      "fontStyle": "bold"
    },
    "method.definition": {
      "foreground": "#87A9FF",
      "fontStyle": "bold"
    },
    "method.static": {
      "foreground": "#87A9FF",
      "fontStyle": "italic"
    },
    "method.declaration.static": {
      "foreground": "#87A9FF",
      "fontStyle": "bold italic"
    },
    "method.static.declaration": {
      "foreground": "#87A9FF",
      "fontStyle": "bold italic"
    },
    "function": {
      "foreground": "#87A9FF",
      "fontStyle": ""
    },
    "function.declaration": {
      "foreground": "#87A9FF",
      "fontStyle": "bold"
    },
    "function.definition": {
      "foreground": "#87A9FF",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#DEB0A8",
      "fontStyle": "italic"
    },
    "variable:typescript": {
      "foreground": "#DEB0A8",
      "fontStyle": ""
    },
    "variable:typescriptreact": {
      "foreground": "#DEB0A8",
      "fontStyle": ""
    },
    "variable:javascript": {
      "foreground": "#DEB0A8",
      "fontStyle": ""
    },
    "variable:javascriptreact": {
      "foreground": "#DEB0A8",
      "fontStyle": ""
    },
    "variable.static": {
      "foreground": "#FF9578",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#FF9578",
      "fontStyle": ""
    },
    "property.static": {
      "foreground": "#FF9578",
      "fontStyle": "italic"
    },
    "property.readonly": {
      "foreground": "#FF9578",
      "fontStyle": ""
    },
    "property.readonly.static": {
      "foreground": "#FF9578",
      "fontStyle": "italic"
    },
    "*.readonly:csharp": {
      "foreground": "#FF9578"
    },
    "namespace": {
      "foreground": "#BD918A",
      "fontStyle": ""
    },
    "operator": {
