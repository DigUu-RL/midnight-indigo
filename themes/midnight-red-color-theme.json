    "statusBar.background": "#120605",
    "statusBar.foreground": "#A9857F",
    "statusBar.border": "#240D0B",
    "statusBar.debuggingBackground": "#7F49C5",
    "statusBar.noFolderBackground": "#120605",
    "statusBarItem.hoverBackground": "#34100F",
