    "sideBarSectionHeader.border": "#290807",
    "statusBar.background": "#150503",
    "statusBar.foreground": "#AD847C",
    "statusBar.border": "#290807",
    "statusBar.debuggingBackground": "#913BBF",
    "statusBar.noFolderBackground": "#150503",
    "statusBarItem.hoverBackground": "#3B0709",
    "statusBarItem.remoteBackground": "#872629",
    "tab.activeBackground": "#150503",
    "tab.activeForeground": "#CFA79F",
    "tab.inactiveBackground": "#070000",
