{
  "name": "Midnight Cyan",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#008887",
    "foreground": "#70A3A7",
    "selection.background": "#002D2D",
    "editor.background": "#000303",
    "editor.foreground": "#70A3A7",
    "editorLineNumber.foreground": "#00565A",
