    "sideBarSectionHeader.background": "#000D0E",
    "sideBarSectionHeader.border": "#00191B",
    "statusBar.background": "#000D0E",
    "statusBar.foreground": "#649498",
    "statusBar.border": "#00191B",
    "statusBar.debuggingBackground": "#5156DD",
    "statusBar.noFolderBackground": "#000D0E",
    "statusBarItem.hoverBackground": "#002323",
    "statusBarItem.remoteBackground": "#005A5B",
    "tab.activeBackground": "#000D0F",
    "tab.activeForeground": "#88B6BA",
    "tab.inactiveBackground": "#000303",
    "tab.inactiveForeground": "#2F767B",
    "tab.border": "#00191B",
    "tab.activeBorderTop": "#008887",
    "tab.unfocusedActiveBorderTop": "#005A5B",
    "editorGroupHeader.tabsBackground": "#000405",
    "editorGroupHeader.border": "#00191B",
    "editorGroup.border": "#00191B",
    "panel.background": "#000405",
    "panel.border": "#00191B",
    "panelTitle.activeBorder": "#008887",
    "panelTitle.activeForeground": "#70A3A7",
    "panelTitle.inactiveForeground": "#2F767B",
    "input.background": "#000D0E",
    "input.border": "#003D40",
    "input.foreground": "#70A3A7",
    "input.placeholderForeground": "#2F767B",
    "dropdown.background": "#000D0E",
    "dropdown.border": "#003D40",
    "dropdown.foreground": "#70A3A7",
    "list.activeSelectionBackground": "#00191B",
    "list.activeSelectionForeground": "#88B6BA",
    "list.inactiveSelectionBackground": "#000D0F",
    "list.hoverBackground": "#000D0F",
    "list.focusBackground": "#002323",
    "list.highlightForeground": "#6EAAFF",
    "scrollbar.shadow": "#000404",
    "scrollbarSlider.background": "#005A5B55",
    "scrollbarSlider.hoverBackground": "#005A5B88",
    "scrollbarSlider.activeBackground": "#008887AA",
    "button.background": "#008887",
    "button.foreground": "#FFFFFF",
    "badge.background": "#005A5B",
    "badge.foreground": "#FFFFFF",
    "terminal.background": "#000303",
    "terminal.foreground": "#70A3A7",
    "terminal.ansiBlack": "#000707",
    "terminal.ansiRed": "#6EAAFF",
    "terminal.ansiGreen": "#AED693",
    "terminal.ansiYellow": "#FFD583",
    "terminal.ansiBlue": "#25BCF1",
    "terminal.ansiMagenta": "#5156DD",
    "terminal.ansiCyan": "#86DDAE",
    "terminal.ansiWhite": "#70A3A7",
    "terminal.ansiBrightBlack": "#00565A",
    "terminal.ansiBrightRed": "#8ABDFF",
    "terminal.ansiBrightGreen": "#C4EBAA",
    "terminal.ansiBrightYellow": "#FFE3B5",
    "terminal.ansiBrightBlue": "#7CD1F4",
    "terminal.ansiBrightMagenta": "#5983FD",
    "terminal.ansiBrightCyan": "#AAF2C8",
    "terminal.ansiBrightWhite": "#DFF0F2",
    "diffEditor.insertedTextBackground": "#AED69322",
    "diffEditor.removedTextBackground": "#6EAAFF22",
    "gitDecoration.modifiedResourceForeground": "#25BCF1",
    "gitDecoration.addedResourceForeground": "#AED693",
    "gitDecoration.deletedResourceForeground": "#6EAAFF",
    "gitDecoration.untrackedResourceForeground": "#FFD583",
    "peekViewEditor.background": "#000303",
    "peekViewResult.background": "#000405",
    "peekView.border": "#005A5B"
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2F767B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.important",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#6EAAFF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Nomes reservados de declaração de tipo NÃO herdam a cor do nome do tipo (fix defensivo interface/enum/struct/record/class)",
      "scope": [
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.type.record",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#6EAAFF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Constantes de linguagem (true/false/null/undefined/this/self)",
      "scope": [
        "constant.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#6EAAFF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#AED693"
      }
    },
    {
      "name": "Sequências de escape dentro de strings",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash"
      ],
      "settings": {
        "foreground": "#6EAAFF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Interpolação de strings (marcadores ${} #{} $())",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6EAAFF"
      }
    },
    {
      "name": "Pontuação e chaves/colchetes/vírgulas",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.terminator.statement",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.accessor",
        "punctuation.definition.typeparameters",
        "punctuation.definition.generic",
        "meta.generic.punctuation",
        "punctuation.brace.angle"
      ],
      "settings": {
        "foreground": "#6EAAFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FAAB7F"
      }
    },
    {
      "name": "Operadores (somente cor, nunca negrito/itálico)",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.new",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.other",
        "punctuation.definition.arrow",
        "punctuation.operator",
        "storage.type.function.arrow",
        "keyword.operator.assignment.compound"
      ],
      "settings": {
        "foreground": "#00B6BB",
        "fontStyle": ""
      }
    },
    {
      "name": "Métodos e funções - declaração",
      "scope": [
        "entity.name.function",
        "meta.function.declaration entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#25BCF1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Métodos e funções - chamada",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.call",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#25BCF1",
        "fontStyle": ""
      }
    },
    {
      "name": "Membros estáticos (métodos, campos e propriedades static) - sempre itálico",
      "scope": [
        "entity.name.function.static",
        "variable.other.property.static",
        "variable.other.object.property.static",
        "meta.definition.variable.static",
        "storage.modifier.static ~ entity.name.function",
        "meta.definition.property.static"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes (inclui sealed - mesmo padrão de classes comuns)",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#86DDAE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Delegates C# (Action / Func / Predicate) - mesma cor de métodos, em negrito",
      "scope": [
        "support.type.delegate.cs",
        "support.class.action",
        "support.class.func",
        "support.class.action.cs",
        "support.class.func.cs"
      ],
      "settings": {
        "foreground": "#25BCF1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Components (JSX/TSX) - mesmo tratamento visual de classes",
      "scope": [
        "support.class.component",
        "entity.name.function.component"
      ],
      "settings": {
        "foreground": "#86DDAE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Records e Structs (mesma regra de classes, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.record",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#86DDAE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes/records/structs estáticos - apenas itálico, sem negrito (fallback léxico; ver semanticTokenColors para cobertura em qualquer ponto de uso)",
      "scope": [
        "entity.name.class.static",
        "meta.class.static entity.name.class"
      ],
      "settings": {
        "foreground": "#86DDAE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interfaces e Enums (mesma cor, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.other.inherited-class.interface",
        "meta.interface"
      ],
      "settings": {
        "foreground": "#FFD583",
        "fontStyle": ""
      }
    },
    {
      "name": "Valores de enum (cor diferenciada)",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#F9938B"
      }
    },
    {
      "name": "Variáveis locais",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.local",
        "meta.definition.variable variable.other"
      ],
      "settings": {
        "foreground": "#8EC3C7",
        "fontStyle": ""
      }
    },
    {
      "name": "Parâmetros de métodos - sempre itálico",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#8EC3C7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades e campos de classes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.field.declaration",
        "variable.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#00C4DB",
        "fontStyle": ""
      }
    },
    {
      "name": "Generics (apenas o nome do tipo, os símbolos < > seguem a cor de pontuação)",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "meta.type.arguments entity.name.type",
        "meta.type.parameters storage.type",
        "meta.type.arguments storage.type"
      ],
      "settings": {
        "foreground": "#5156DD",
        "fontStyle": ""
      }
    },
    {
      "name": "Decoradores / Atributos (JS, TS, Python, C#)",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#FAAB7F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tipos primitivos",
      "scope": [
        "support.type",
        "storage.type.primitive",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#86DDAE",
        "fontStyle": ""
      }
    },
    {
      "name": "PowerShell - Variáveis ($var)",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell"
      ],
      "settings": {
        "foreground": "#8EC3C7"
      }
    },
    {
      "name": "PowerShell - Cmdlets",
      "scope": [
        "support.function.powershell",
        "entity.name.function.powershell"
      ],
      "settings": {
        "foreground": "#25BCF1"
      }
    },
    {
      "name": "PowerShell - Parâmetros (-Param)",
      "scope": [
        "variable.parameter.powershell"
      ],
      "settings": {
        "foreground": "#8EC3C7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Cabeçalhos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#86DDAE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#70A3A7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#70A3A7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Links",
      "scope": [
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#25BCF1",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown - Código inline/bloco",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#F9938B"
      }
    },
    {
      "name": "Markdown - Citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#2F767B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON - Chaves (keys)",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#00C4DB"
      }
    },
    {
      "name": "JSON - Valores string",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#AED693"
      }
    },
    {
      "name": "JSON - Constantes (true/false/null)",
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#6EAAFF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Tags/atributos genéricos de markup",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#00C4DB",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#86DDAE",
      "fontStyle": "bold"
    },
    "class.static": {
      "foreground": "#86DDAE",
      "fontStyle": "italic"
    },
    "class.sealed": {
      "foreground": "#86DDAE",
      "fontStyle": "bold"
    },
    "delegate": {
      "foreground": "#25BCF1",
      "fontStyle": "bold"
    },
    "struct": {
      "foreground": "#86DDAE",
      "fontStyle": "bold"
    },
    "struct.static": {
      "foreground": "#86DDAE",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#FFD583",
      "fontStyle": ""
    },
    "enum": {
      "foreground": "#FFD583",
      "fontStyle": ""
    },
    "enumMember": {
      "foreground": "#F9938B",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#5156DD",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#86DDAE",
      "fontStyle": ""
    },
    "method": {
      "foreground": "#25BCF1",
      "fontStyle": ""
    },
    "method.declaration": {
      "foreground": "#25BCF1",
      "fontStyle": "bold"
    },
    "method.definition": {
      "foreground": "#25BCF1",
      "fontStyle": "bold"
    },
    "method.static": {
      "foreground": "#25BCF1",
      "fontStyle": "italic"
    },
    "method.declaration.static": {
      "foreground": "#25BCF1",
      "fontStyle": "bold italic"
    },
    "method.static.declaration": {
      "foreground": "#25BCF1",
      "fontStyle": "bold italic"
    },
    "function": {
      "foreground": "#25BCF1",
      "fontStyle": ""
    },
    "function.declaration": {
      "foreground": "#25BCF1",
      "fontStyle": "bold"
    },
    "function.definition": {
      "foreground": "#25BCF1",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#8EC3C7",
      "fontStyle": "italic"
    },
    "variable:typescript": {
      "foreground": "#8EC3C7",
      "fontStyle": ""
    },
    "variable:typescriptreact": {
      "foreground": "#8EC3C7",
      "fontStyle": ""
    },
    "variable:javascript": {
      "foreground": "#8EC3C7",
      "fontStyle": ""
    },
    "variable:javascriptreact": {
      "foreground": "#8EC3C7",
      "fontStyle": ""
    },
    "variable.static": {
      "foreground": "#00C4DB",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#00C4DB",
      "fontStyle": ""
    },
    "property.static": {
      "foreground": "#00C4DB",
      "fontStyle": "italic"
    },
    "property.readonly": {
      "foreground": "#00C4DB",
      "fontStyle": ""
    },
    "property.readonly.static": {
      "foreground": "#00C4DB",
      "fontStyle": "italic"
    },
    "*.readonly:csharp": {
      "foreground": "#00C4DB"
    },
    "namespace": {
      "foreground": "#70A3A7",
      "fontStyle": ""
    },
    "operator": {
      "foreground": "#00B6BB",
      "fontStyle": ""
    },
    "keyword": {
