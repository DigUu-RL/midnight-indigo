    "statusBar.border": "#250A18",
    "statusBar.debuggingBackground": "#AA28A4",
    "statusBar.noFolderBackground": "#13050B",
    "statusBarItem.hoverBackground": "#340B24",
    "statusBarItem.remoteBackground": "#7F2B60",
    "tab.activeBackground": "#13050B",
