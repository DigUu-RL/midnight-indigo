    "statusBar.background": "#130600",
    "statusBar.foreground": "#B6977D",
    "statusBar.border": "#230F00",
    "statusBar.debuggingBackground": "#B52487",
    "statusBar.noFolderBackground": "#130600",
    "statusBarItem.hoverBackground": "#301500",
    "statusBarItem.remoteBackground": "#773C00",
    "tab.activeBackground": "#130700",
