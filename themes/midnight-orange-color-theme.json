    "tab.inactiveForeground": "#936B49",
    "tab.border": "#230F00",
    "tab.activeBorderTop": "#C86300",
    "tab.unfocusedActiveBorderTop": "#773C00",
    "editorGroupHeader.tabsBackground": "#060200",
    "editorGroupHeader.border": "#230F00",
    "editorGroup.border": "#230F00",
    "panel.background": "#060200",
    "panel.border": "#230F00",
    "panelTitle.activeBorder": "#C86300",
    "panelTitle.activeForeground": "#C6A589",
    "panelTitle.inactiveForeground": "#936B49",
    "input.background": "#130600",
    "input.border": "#502900",
    "input.foreground": "#C6A589",
    "input.placeholderForeground": "#936B49",
    "dropdown.background": "#130600",
    "dropdown.border": "#502900",
    "dropdown.foreground": "#C6A589",
    "list.activeSelectionBackground": "#230F00",
    "list.activeSelectionForeground": "#D8BBA1",
    "list.inactiveSelectionBackground": "#130700",
    "list.hoverBackground": "#130700",
    "list.focusBackground": "#301500",
    "list.highlightForeground": "#FF739E",
    "scrollbar.shadow": "#070200",
    "scrollbarSlider.background": "#773C0055",
    "scrollbarSlider.hoverBackground": "#773C0088",
    "scrollbarSlider.activeBackground": "#C86300AA",
    "button.background": "#C86300",
    "button.foreground": "#FFFFFF",
    "badge.background": "#773C00",
    "badge.foreground": "#FFFFFF",
    "terminal.background": "#040100",
    "terminal.foreground": "#C6A589",
    "terminal.ansiBlack": "#0B0300",
    "terminal.ansiRed": "#FF739E",
    "terminal.ansiGreen": "#6ECCB1",
    "terminal.ansiYellow": "#73E885",
    "terminal.ansiBlue": "#8DA7FF",
    "terminal.ansiMagenta": "#B52487",
    "terminal.ansiCyan": "#68D2F1",
    "terminal.ansiWhite": "#C6A589",
    "terminal.ansiBrightBlack": "#68411C",
    "terminal.ansiBrightRed": "#FF96AF",
    "terminal.ansiBrightGreen": "#87E0C6",
    "terminal.ansiBrightYellow": "#9EF09E",
    "terminal.ansiBrightBlue": "#ACC2FF",
    "terminal.ansiBrightMagenta": "#DE5196",
    "terminal.ansiBrightCyan": "#96E7FF",
    "terminal.ansiBrightWhite": "#FFFBF7",
    "diffEditor.insertedTextBackground": "#6ECCB122",
    "diffEditor.removedTextBackground": "#FF739E22",
    "gitDecoration.modifiedResourceForeground": "#8DA7FF",
    "gitDecoration.addedResourceForeground": "#6ECCB1",
    "gitDecoration.deletedResourceForeground": "#FF739E",
    "gitDecoration.untrackedResourceForeground": "#73E885",
    "peekViewEditor.background": "#040100",
    "peekViewResult.background": "#060200",
    "peekView.border": "#773C00"
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#936B49",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.important",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#FF739E",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Nomes reservados de declaração de tipo NÃO herdam a cor do nome do tipo (fix defensivo interface/enum/struct/record/class)",
      "scope": [
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.type.record",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#FF739E",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Constantes de linguagem (true/false/null/undefined/this/self)",
      "scope": [
        "constant.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#FF739E",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#6ECCB1"
      }
    },
    {
      "name": "Sequências de escape dentro de strings",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash"
      ],
      "settings": {
        "foreground": "#FF739E",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Interpolação de strings (marcadores ${} #{} $())",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FF739E"
      }
    },
    {
      "name": "Pontuação e chaves/colchetes/vírgulas",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.terminator.statement",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.accessor",
        "punctuation.definition.typeparameters",
        "punctuation.definition.generic",
        "meta.generic.punctuation",
        "punctuation.brace.angle"
      ],
      "settings": {
        "foreground": "#FF739E",
        "fontStyle": ""
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D5D37C"
      }
    },
    {
      "name": "Operadores (somente cor, nunca negrito/itálico)",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.new",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.other",
        "punctuation.definition.arrow",
        "punctuation.operator",
        "storage.type.function.arrow",
        "keyword.operator.assignment.compound"
      ],
      "settings": {
        "foreground": "#FD9432",
        "fontStyle": ""
      }
    },
    {
      "name": "Métodos e funções - declaração",
      "scope": [
        "entity.name.function",
        "meta.function.declaration entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#8DA7FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Métodos e funções - chamada",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.call",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8DA7FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Membros estáticos (métodos, campos e propriedades static) - sempre itálico",
      "scope": [
        "entity.name.function.static",
        "variable.other.property.static",
        "variable.other.object.property.static",
        "meta.definition.variable.static",
        "storage.modifier.static ~ entity.name.function",
        "meta.definition.property.static"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes (inclui sealed - mesmo padrão de classes comuns)",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#68D2F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Delegates C# (Action / Func / Predicate) - mesma cor de métodos, em negrito",
      "scope": [
        "support.type.delegate.cs",
        "support.class.action",
        "support.class.func",
        "support.class.action.cs",
        "support.class.func.cs"
      ],
      "settings": {
        "foreground": "#8DA7FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Components (JSX/TSX) - mesmo tratamento visual de classes",
      "scope": [
        "support.class.component",
        "entity.name.function.component"
      ],
      "settings": {
        "foreground": "#68D2F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Records e Structs (mesma regra de classes, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.record",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#68D2F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes/records/structs estáticos - apenas itálico, sem negrito (fallback léxico; ver semanticTokenColors para cobertura em qualquer ponto de uso)",
      "scope": [
        "entity.name.class.static",
        "meta.class.static entity.name.class"
      ],
      "settings": {
        "foreground": "#68D2F1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interfaces e Enums (mesma cor, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.other.inherited-class.interface",
        "meta.interface"
      ],
      "settings": {
        "foreground": "#73E885",
        "fontStyle": ""
      }
    },
    {
      "name": "Valores de enum (cor diferenciada)",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#EFC866"
      }
    },
    {
      "name": "Variáveis locais",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.local",
        "meta.definition.variable variable.other"
      ],
      "settings": {
        "foreground": "#E7C5A8",
        "fontStyle": ""
      }
    },
    {
      "name": "Parâmetros de métodos - sempre itálico",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#E7C5A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades e campos de classes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.field.declaration",
        "variable.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#FDB55C",
        "fontStyle": ""
      }
    },
    {
      "name": "Generics (apenas o nome do tipo, os símbolos < > seguem a cor de pontuação)",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "meta.type.arguments entity.name.type",
        "meta.type.parameters storage.type",
        "meta.type.arguments storage.type"
      ],
      "settings": {
        "foreground": "#B52487",
        "fontStyle": ""
      }
    },
    {
      "name": "Decoradores / Atributos (JS, TS, Python, C#)",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#D5D37C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tipos primitivos",
      "scope": [
        "support.type",
        "storage.type.primitive",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#68D2F1",
        "fontStyle": ""
      }
    },
    {
      "name": "PowerShell - Variáveis ($var)",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell"
      ],
      "settings": {
        "foreground": "#E7C5A8"
      }
    },
    {
      "name": "PowerShell - Cmdlets",
      "scope": [
        "support.function.powershell",
        "entity.name.function.powershell"
      ],
      "settings": {
        "foreground": "#8DA7FF"
      }
    },
    {
      "name": "PowerShell - Parâmetros (-Param)",
      "scope": [
        "variable.parameter.powershell"
      ],
      "settings": {
        "foreground": "#E7C5A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Cabeçalhos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#68D2F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C6A589",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C6A589",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Links",
      "scope": [
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8DA7FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown - Código inline/bloco",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#EFC866"
      }
    },
    {
      "name": "Markdown - Citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#936B49",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON - Chaves (keys)",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#FDB55C"
      }
    },
    {
      "name": "JSON - Valores string",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#6ECCB1"
      }
    },
    {
      "name": "JSON - Constantes (true/false/null)",
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#FF739E",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Tags/atributos genéricos de markup",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FDB55C",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#68D2F1",
      "fontStyle": "bold"
    },
    "class.static": {
      "foreground": "#68D2F1",
      "fontStyle": "italic"
    },
    "class.sealed": {
      "foreground": "#68D2F1",
      "fontStyle": "bold"
    },
    "delegate": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold"
    },
    "struct": {
      "foreground": "#68D2F1",
      "fontStyle": "bold"
    },
    "struct.static": {
      "foreground": "#68D2F1",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#73E885",
      "fontStyle": ""
    },
    "enum": {
      "foreground": "#73E885",
      "fontStyle": ""
    },
    "enumMember": {
      "foreground": "#EFC866",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#B52487",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#68D2F1",
      "fontStyle": ""
    },
    "method": {
      "foreground": "#8DA7FF",
      "fontStyle": ""
    },
    "method.declaration": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold"
    },
    "method.definition": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold"
    },
    "method.static": {
      "foreground": "#8DA7FF",
      "fontStyle": "italic"
    },
    "method.declaration.static": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold italic"
    },
    "method.static.declaration": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold italic"
    },
    "function": {
      "foreground": "#8DA7FF",
      "fontStyle": ""
    },
    "function.declaration": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold"
    },
    "function.definition": {
      "foreground": "#8DA7FF",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#E7C5A8",
      "fontStyle": "italic"
    },
    "variable:typescript": {
      "foreground": "#E7C5A8",
      "fontStyle": ""
    },
    "variable:typescriptreact": {
      "foreground": "#E7C5A8",
      "fontStyle": ""
    },
    "variable:javascript": {
      "foreground": "#E7C5A8",
      "fontStyle": ""
    },
    "variable:javascriptreact": {
      "foreground": "#E7C5A8",
      "fontStyle": ""
    },
    "variable.static": {
      "foreground": "#FDB55C",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#FDB55C",
      "fontStyle": ""
    },
    "property.static": {
      "foreground": "#FDB55C",
      "fontStyle": "italic"
    },
    "property.readonly": {
      "foreground": "#FDB55C",
      "fontStyle": ""
    },
    "property.readonly.static": {
      "foreground": "#FDB55C",
      "fontStyle": "italic"
    },
    "*.readonly:csharp": {
