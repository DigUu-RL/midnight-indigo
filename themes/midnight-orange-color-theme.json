    "tab.border": "#211003",
    "tab.activeBorderTop": "#BF5C00",
    "tab.unfocusedActiveBorderTop": "#7C410E",
    "editorGroupHeader.tabsBackground": "#050301",
    "editorGroupHeader.border": "#211003",
    "editorGroup.border": "#211003",
    "panel.background": "#050301",
    "panel.border": "#211003",
    "panelTitle.activeBorder": "#BF5C00",
    "panelTitle.activeForeground": "#C1A791",
    "panelTitle.inactiveForeground": "#8D6D53",
    "input.background": "#100802",
    "input.border": "#4B2C10",
    "input.foreground": "#C1A791",
    "input.placeholderForeground": "#8D6D53",
    "dropdown.background": "#100802",
    "dropdown.border": "#4B2C10",
    "dropdown.foreground": "#C1A791",
    "list.activeSelectionBackground": "#211003",
    "list.activeSelectionForeground": "#D4BCA8",
    "list.inactiveSelectionBackground": "#100802",
    "list.hoverBackground": "#100802",
    "list.focusBackground": "#301501",
    "list.highlightForeground": "#D77DF9",
    "scrollbar.shadow": "#060201",
    "scrollbarSlider.background": "#7C410E55",
    "scrollbarSlider.hoverBackground": "#7C410E88",
    "scrollbarSlider.activeBackground": "#BF5C00AA",
    "button.background": "#BF5C00",
    "button.foreground": "#FFFFFF",
    "badge.background": "#7C410E",
    "badge.foreground": "#FFFFFF",
    "terminal.background": "#040100",
    "terminal.foreground": "#C1A791",
    "terminal.ansiBlack": "#0A0300",
    "terminal.ansiRed": "#D77DF9",
    "terminal.ansiGreen": "#90D0A1",
    "terminal.ansiYellow": "#CAE75D",
    "terminal.ansiBlue": "#63B3FB",
    "terminal.ansiMagenta": "#6652D4",
    "terminal.ansiCyan": "#69D7D0",
    "terminal.ansiWhite": "#C1A791",
    "terminal.ansiBrightBlack": "#634328",
    "terminal.ansiBrightRed": "#DC9CFC",
    "terminal.ansiBrightGreen": "#A7E5B6",
    "terminal.ansiBrightYellow": "#DEF18A",
    "terminal.ansiBrightBlue": "#93CAFC",
    "terminal.ansiBrightMagenta": "#727EF7",
    "terminal.ansiBrightCyan": "#92ECE4",
    "terminal.ansiBrightWhite": "#FFFBF7",
    "diffEditor.insertedTextBackground": "#90D0A122",
    "diffEditor.removedTextBackground": "#D77DF922",
    "gitDecoration.modifiedResourceForeground": "#63B3FB",
    "gitDecoration.addedResourceForeground": "#90D0A1",
    "gitDecoration.deletedResourceForeground": "#D77DF9",
    "gitDecoration.untrackedResourceForeground": "#CAE75D",
    "peekViewEditor.background": "#040100",
    "peekViewResult.background": "#050301",
    "peekView.border": "#7C410E"
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8D6D53",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.important",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#D77DF9",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Nomes reservados de declaração de tipo NÃO herdam a cor do nome do tipo (fix defensivo interface/enum/struct/record/class)",
      "scope": [
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.type.record",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#D77DF9",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Constantes de linguagem (true/false/null/undefined/this/self)",
      "scope": [
        "constant.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#D77DF9",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#90D0A1"
      }
    },
    {
      "name": "Sequências de escape dentro de strings",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash"
      ],
      "settings": {
        "foreground": "#D77DF9",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Interpolação de strings (marcadores ${} #{} $())",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#D77DF9"
      }
    },
    {
      "name": "Pontuação e chaves/colchetes/vírgulas",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.separator.comma",
        "punctuation.terminator.statement",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.accessor",
        "punctuation.definition.typeparameters",
        "punctuation.definition.generic",
        "meta.generic.punctuation",
        "punctuation.brace.angle"
      ],
      "settings": {
        "foreground": "#D77DF9",
        "fontStyle": ""
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F09A97"
      }
    },
    {
      "name": "Operadores (somente cor, nunca negrito/itálico)",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.new",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.other",
        "punctuation.definition.arrow",
        "punctuation.operator",
        "storage.type.function.arrow",
        "keyword.operator.assignment.compound"
      ],
      "settings": {
        "foreground": "#F09C57",
        "fontStyle": ""
      }
    },
    {
      "name": "Métodos e funções - declaração",
      "scope": [
        "entity.name.function",
        "meta.function.declaration entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#63B3FB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Métodos e funções - chamada",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.call",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#63B3FB",
        "fontStyle": ""
      }
    },
    {
      "name": "Membros estáticos (métodos, campos e propriedades static) - sempre itálico",
      "scope": [
        "entity.name.function.static",
        "variable.other.property.static",
        "variable.other.object.property.static",
        "meta.definition.variable.static",
        "storage.modifier.static ~ entity.name.function",
        "meta.definition.property.static"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes (inclui sealed - mesmo padrão de classes comuns)",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#69D7D0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Delegates C# (Action / Func / Predicate) - mesma cor de métodos, em negrito",
      "scope": [
        "support.type.delegate.cs",
        "support.class.action",
        "support.class.func",
        "support.class.action.cs",
        "support.class.func.cs"
      ],
      "settings": {
        "foreground": "#63B3FB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Components (JSX/TSX) - mesmo tratamento visual de classes",
      "scope": [
        "support.class.component",
        "entity.name.function.component"
      ],
      "settings": {
        "foreground": "#69D7D0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Records e Structs (mesma regra de classes, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.record",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#69D7D0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes/records/structs estáticos - apenas itálico, sem negrito (fallback léxico; ver semanticTokenColors para cobertura em qualquer ponto de uso)",
      "scope": [
        "entity.name.class.static",
        "meta.class.static entity.name.class"
      ],
      "settings": {
        "foreground": "#69D7D0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interfaces e Enums (mesma cor, apenas o nome do tipo)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.other.inherited-class.interface",
        "meta.interface"
      ],
      "settings": {
        "foreground": "#CAE75D",
        "fontStyle": ""
      }
    },
    {
      "name": "Valores de enum (cor diferenciada)",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#E991BB"
      }
    },
    {
      "name": "Variáveis locais",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.local",
        "meta.definition.variable variable.other"
      ],
      "settings": {
        "foreground": "#E2C6AF",
        "fontStyle": ""
      }
    },
    {
      "name": "Parâmetros de métodos - sempre itálico",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#E2C6AF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades e campos de classes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.field.declaration",
        "variable.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F3B976",
        "fontStyle": ""
      }
    },
    {
      "name": "Generics (apenas o nome do tipo, os símbolos < > seguem a cor de pontuação)",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "meta.type.arguments entity.name.type",
        "meta.type.parameters storage.type",
        "meta.type.arguments storage.type"
      ],
      "settings": {
        "foreground": "#6652D4",
        "fontStyle": ""
      }
    },
    {
      "name": "Decoradores / Atributos (JS, TS, Python, C#)",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#F09A97",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tipos primitivos",
      "scope": [
        "support.type",
        "storage.type.primitive",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#69D7D0",
        "fontStyle": ""
      }
    },
    {
      "name": "PowerShell - Variáveis ($var)",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell"
      ],
      "settings": {
        "foreground": "#E2C6AF"
      }
    },
    {
      "name": "PowerShell - Cmdlets",
      "scope": [
        "support.function.powershell",
        "entity.name.function.powershell"
      ],
      "settings": {
        "foreground": "#63B3FB"
      }
    },
    {
      "name": "PowerShell - Parâmetros (-Param)",
      "scope": [
        "variable.parameter.powershell"
      ],
      "settings": {
        "foreground": "#E2C6AF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Cabeçalhos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#69D7D0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C1A791",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C1A791",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Links",
      "scope": [
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#63B3FB",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown - Código inline/bloco",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#E991BB"
      }
    },
    {
      "name": "Markdown - Citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8D6D53",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON - Chaves (keys)",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#F3B976"
      }
    },
    {
      "name": "JSON - Valores string",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#90D0A1"
      }
    },
    {
      "name": "JSON - Constantes (true/false/null)",
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#D77DF9",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Tags/atributos genéricos de markup",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F3B976",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#69D7D0",
      "fontStyle": "bold"
    },
    "class.static": {
      "foreground": "#69D7D0",
      "fontStyle": "italic"
    },
    "class.sealed": {
      "foreground": "#69D7D0",
      "fontStyle": "bold"
    },
    "delegate": {
      "foreground": "#63B3FB",
      "fontStyle": "bold"
    },
    "struct": {
      "foreground": "#69D7D0",
      "fontStyle": "bold"
    },
    "struct.static": {
      "foreground": "#69D7D0",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#CAE75D",
      "fontStyle": ""
    },
    "enum": {
      "foreground": "#CAE75D",
      "fontStyle": ""
    },
    "enumMember": {
      "foreground": "#E991BB",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#6652D4",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#69D7D0",
      "fontStyle": ""
    },
    "method": {
      "foreground": "#63B3FB",
      "fontStyle": ""
    },
    "method.declaration": {
      "foreground": "#63B3FB",
      "fontStyle": "bold"
    },
    "method.definition": {
      "foreground": "#63B3FB",
      "fontStyle": "bold"
    },
    "method.static": {
      "foreground": "#63B3FB",
      "fontStyle": "italic"
    },
    "method.declaration.static": {
      "foreground": "#63B3FB",
      "fontStyle": "bold italic"
    },
    "method.static.declaration": {
      "foreground": "#63B3FB",
      "fontStyle": "bold italic"
    },
    "function": {
      "foreground": "#63B3FB",
      "fontStyle": ""
    },
    "function.declaration": {
      "foreground": "#63B3FB",
      "fontStyle": "bold"
    },
    "function.definition": {
      "foreground": "#63B3FB",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#E2C6AF",
      "fontStyle": "italic"
    },
    "variable:typescript": {
      "foreground": "#E2C6AF",
      "fontStyle": ""
    },
    "variable:typescriptreact": {
      "foreground": "#E2C6AF",
      "fontStyle": ""
    },
    "variable:javascript": {
      "foreground": "#E2C6AF",
      "fontStyle": ""
    },
    "variable:javascriptreact": {
      "foreground": "#E2C6AF",
      "fontStyle": ""
    },
    "variable.static": {
      "foreground": "#F3B976",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#F3B976",
      "fontStyle": ""
    },
    "property.static": {
      "foreground": "#F3B976",
      "fontStyle": "italic"
    },
    "property.readonly": {
      "foreground": "#F3B976",
      "fontStyle": ""
    },
    "property.readonly.static": {
      "foreground": "#F3B976",
